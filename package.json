{
  "name": "shuguang-intelligence",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "swordfate3",
  "type": "module",
  "description": "曙光智慧：独立数字伙伴内核、MCP与Pi资源包",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./packages/pi-package/src/index.ts"],
    "skills": ["./packages/pi-package/skills"]
  },
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "test": "node --test packages/dawn/tests/*.test.ts packages/mcp/tests/*.test.ts packages/pi-package/tests/*.test.ts",
    "test:mcp": "node --test packages/mcp/tests/*.test.ts",
    "test:pi-package": "node --test packages/pi-package/tests/*.test.ts",
    "mcp": "node packages/mcp/src/main.ts",
    "mcp:http": "node packages/mcp/src/http-main.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node packages/dawn/src/main.ts",
    "check:capabilities": "node packages/dawn/src/main.ts --check",
    "check:skeleton": "npm run check:capabilities",
    "verify:dialogue": "node scripts/acceptance.ts",
    "verify:learning": "node --test packages/dawn/tests/learning-core.test.ts packages/dawn/tests/learning-storage.test.ts packages/dawn/tests/learning-runner.test.ts packages/dawn/tests/learning-cli.test.ts",
    "verify:learning:offline": "node scripts/learning-acceptance.ts",
    "verify:acceptance": "npm run verify:dialogue && npm run verify:learning"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "~1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
